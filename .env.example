# Copy to .env and fill in. Never commit .env.

# PostgreSQL (used by both the db and api services)
POSTGRES_DB=ado
POSTGRES_USER=ado
POSTGRES_PASSWORD=change-me

# Your Azure DevOps organization (keep the trailing slash)
ADO_ORGANIZATION_URL=https://dev.azure.com/your-organization/
ADO_ANALYTICS_ORGANIZATION_URL=https://analytics.dev.azure.com/your-organization/

# Key used to encrypt stored Personal Access Tokens: base64 of 32 random bytes.
# Generate with: openssl rand -base64 32
PAT_ENCRYPTION_KEY=
